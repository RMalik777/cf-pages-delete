# Cloudflare OAuth client (dash > Manage Account > OAuth clients)
CLOUDFLARE_CLIENT_ID=
CLOUDFLARE_CLIENT_SECRET=
# Space-separated scope IDs. Must match the scopes enabled on the OAuth client.
CLOUDFLARE_OAUTH_SCOPES="account-settings.read page.read page.write user-details.read"

# better-auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
